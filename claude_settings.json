{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(/**)",
      "Write(/**)",
      "Edit(/**)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "WebSearch",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:tauri.app)",
      "WebFetch(domain:v2.tauri.app)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:vite.dev)",
      "WebFetch(domain:doc.rust-lang.org)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:npmjs.com)",
      "WebFetch(domain:www.npmjs.com)",
      "EnterWorktree"
    ],
    "deny": [
      "Read(//**/.env)",
      "Write(//**/.env)",
      "Edit(//**/.env)",
      "Read(//**/.env.*)",
      "Write(//**/.env.*)",
      "Edit(//**/.env.*)",
      "Write(/.claude/settings.json)",
      "Edit(/.claude/settings.json)",
      "Write(/.codex/config.toml)",
      "Edit(/.codex/config.toml)",
      "Write(/.codex/rules/**)",
      "Edit(/.codex/rules/**)",
      "Read(~/.ssh/**)",
      "Read(~/.docker/**)",
      "Read(~/.zsh_history)",
      "Read(~/.lesshst)",
      "Read(~/.viminfo)",
      "Read(~/.zsh_sessions/**)",
      "Read(~/.claude.json)",
      "Read(~/.claude.json.backup)",
      "Read(~/.codex/**)",
      "Read(~/.cursor/**)",
      "Bash(git add .)",
      "Bash(git add ./)",
      "Bash(git add ..)",
      "Bash(git add -- .)",
      "Bash(git add -- ./)",
      "Bash(git add -- ..)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add -u*)",
      "Bash(git add --update*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit *--no-verify*)"
    ],
    "ask": ["Bash(git push)", "Bash(git push *)"]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": ["registry.npmjs.org"]
    },
    "filesystem": {
      "denyRead": ["~/"],
      "allowRead": ["."]
    },
    "excludedCommands": ["git *", "codex *"]
  },
  "worktree": {
    "baseRef": "fresh",
    "symlinkDirectories": ["node_modules"]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  }
}
