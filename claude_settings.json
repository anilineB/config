{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["git *"],
    "filesystem": {
      "denyRead": ["~/"],
      "allowRead": [".", "~/.claude"],
      "allowWrite": ["~/.claude"]
    },
    "network": {
      "allowedDomains": ["registry.npmjs.org"],
      "deniedDomains": [
        "webhook.site",
        "*.webhook.site",
        "requestbin.com",
        "*.requestbin.com",
        "pastebin.com",
        "*.pastebin.com"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Read(/**)",
      "Write(/**)",
      "Edit(/**)",
      "Read(~/.claude/**)",
      "Write(~/.claude/**)",
      "Edit(~/.claude/**)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": ["Bash(git push *)", "Bash(git worktree *)", "Bash(git stash *)"],
    "deny": [
      "Read(.env)",
      "Write(.env)",
      "Edit(.env)",
      "Read(.env.*)",
      "Write(.env.*)",
      "Edit(.env.*)",
      "Write(.claude/settings.json)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.local.json)",
      "Edit(.claude/settings.local.json)",
      "Write(.claude/hooks/**)",
      "Edit(.claude/hooks/**)",
      "Write(~/.claude/settings.json)",
      "Edit(~/.claude/settings.json)",
      "Write(~/.claude/settings.local.json)",
      "Edit(~/.claude/settings.local.json)",
      "Write(~/.claude/hooks/**)",
      "Edit(~/.claude/hooks/**)",
      "Read(~/.ssh/**)",
      "Write(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.boto/**)",
      "Write(~/.boto/**)",
      "Edit(~/.boto/**)",
      "Read(~/.docker/**)",
      "Write(~/.docker/**)",
      "Edit(~/.docker/**)",
      "Read(~/.zsh_history)",
      "Read(~/.bash_history)",
      "Read(~/.python_history)",
      "Read(~/.node_repl_history)",
      "Read(~/.lesshst)",
      "Read(~/.viminfo)",
      "Read(~/.zsh_sessions/**)",
      "Read(~/.zshrc)",
      "Write(~/.zshrc)",
      "Edit(~/.zshrc)",
      "Read(~/.zprofile)",
      "Write(~/.zprofile)",
      "Edit(~/.zprofile)",
      "Read(~/.bashrc)",
      "Write(~/.bashrc)",
      "Edit(~/.bashrc)",
      "Read(~/.claude.json)",
      "Write(~/.claude.json)",
      "Edit(~/.claude.json)",
      "Read(~/.claude.json.backup)",
      "Write(~/.claude.json.backup)",
      "Edit(~/.claude.json.backup)",
      "Read(~/.codex/**)",
      "Write(~/.codex/**)",
      "Edit(~/.codex/**)",
      "Read(~/.gemini/**)",
      "Write(~/.gemini/**)",
      "Edit(~/.gemini/**)",
      "Read(~/.cursor/**)",
      "Write(~/.cursor/**)",
      "Edit(~/.cursor/**)",
      "Read(~/.antigravity/**)",
      "Write(~/.antigravity/**)",
      "Edit(~/.antigravity/**)",
      "Bash(git add .)",
      "Bash(git add -A)",
      "Bash(git add --all)",
      "Bash(git commit --amend *)",
      "Bash(git commit -a *)",
      "Bash(git commit --all *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit --no-gpg-sign *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -fx *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push --mirror *)",
      "Bash(git push --delete *)",
      "Bash(git push --prune *)",
      "Bash(git push --no-verify *)",
      "Bash(git remote *)",
      "Bash(git config *)",
      "Bash(git clone *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git submodule *)",
      "Bash(git bundle *)",
      "Bash(git ls-remote *)"
    ]
  }
}
